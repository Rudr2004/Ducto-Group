# dependencies
node_modules/
.pnp
.pnp.js

# build output
dist/
dist-single/
build/
*.tsbuildinfo

# environment / secrets (keep the template)
.env
.env.*
!.env.example

# deploy tooling
.vercel/
.render/

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# tests / coverage
coverage/
.vitest-cache/

# caches
.cache/
.eslintcache
.parcel-cache/
.vite/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# editors
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Claude Code local settings (project instructions in .claude/ stay tracked)
.claude/settings.local.json

# Excel lock / temp files (the sample workbook in sample_data/ must stay tracked: it is bundled into the build)
~$*
*.tmp
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
